# ---- Core -------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:5310
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dealer_intel
REDIS_URL=redis://127.0.0.1:6379

# First admin account, created by `npm run db:seed` if no users exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Evidence storage (S3-compatible) -----------------------------------
# STORAGE_DRIVER=s3 for MinIO/S3/R2. "local" writes to STORAGE_LOCAL_DIR (dev only).
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=.data/evidence
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=dealer-intel-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- AI (optional; the app runs without it) -----------------------------
# AI_PROVIDER=anthropic | none
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# ---- Inbound response webhooks -------------------------------------------
# Shared secret sent as the `x-webhook-secret` header by email/phone providers.
WEBHOOK_SECRET=
# If set, /api/webhooks/sms validates the X-Twilio-Signature header.
# Phone checks (Charlie calls the dealership). Trial accounts can only call verified numbers; upgrade to call anyone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Crawler -----------------------------------------------------------
CRAWLER_USER_AGENT_SUFFIX=DealerIntelResearch/0.1
CRAWLER_PAGE_DELAY_MS=1500
CRAWLER_MAX_PAGES=10
WORKER_CONCURRENCY=2

# ---- Interaction hard limits (env is a ceiling; admin settings can only be stricter) ----
MAX_CHAT_MESSAGES=3
MAX_TESTS_PER_DEALERSHIP_PER_30_DAYS=1
MAX_HUMAN_REPLIES=1
ALLOW_APPOINTMENT_BOOKING=false
ALLOW_FINANCE_APPLICATIONS=false
ALLOW_TRADE_IN=false
ALLOW_TEST_DRIVE=false

# ---- Docker Compose only ----
POSTGRES_USER=dealer
POSTGRES_PASSWORD=

# Realistic agent voices (optional): one of these. Without them the Windows speech engine is used.
TTS_PROVIDER=auto
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
