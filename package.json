{
  "name": "dealer-intel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "fast": "node scripts/dev-local.mjs --prod",
    "dev:web": "next dev -p 5310",
    "dev:workers": "tsx watch src/workers/index.ts",
    "build": "next build",
    "start": "next start -p 5310",
    "workers": "tsx src/workers/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "fixture-site": "tsx tests/fixtures/site-server.ts",
    "playwright:install": "playwright install chromium",
    "agent-check": "node scripts/with-dev-env.mjs scripts/agent-check.ts",
    "estimate-admin": "node scripts/with-dev-env.mjs scripts/estimate-admin.ts",
    "chat-diagnose": "node scripts/with-dev-env.mjs scripts/chat-diagnose.ts",
    "prospect-admin": "node scripts/with-dev-env.mjs scripts/prospect-admin.ts",
    "settings-admin": "node scripts/with-dev-env.mjs scripts/settings-admin.ts",
    "phone-admin": "node scripts/with-dev-env.mjs scripts/phone-admin.ts",
    "sync-to-hosted": "node scripts/with-dev-env.mjs scripts/sync-to-hosted.ts",
    "intent-admin": "node scripts/with-dev-env.mjs scripts/intent-admin.ts",
    "ownership-admin": "node scripts/with-dev-env.mjs scripts/ownership-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@tailwindcss/postcss": "^4.3.3",
    "bullmq": "^6.3.11",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "motion": "^12.43.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "redis-memory-server": "^0.17.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
